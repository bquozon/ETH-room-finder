{
	servers {
		# keep the visitor's address from the main proxy (to count each visitor once a day)
		trusted_proxies static private_ranges
		# read X-Forwarded-For from the right: the left part is whatever the visitor sent
		trusted_proxies_strict
	}
}

:80 {
	encode zstd gzip

	# Visit statistics (api/): hits from the page, and the stats page behind a password.
	# install.sh writes the login to stats-users.caddy (git-ignored).
	handle /api/hit {
		reverse_proxy eth-room-finder-api:8790 {
			header_up X-Real-IP {client_ip}
		}
	}
	@oldstats path /stats /stats/
	redir @oldstats /api/stats
	handle /api/stats* {
		basic_auth {
			import stats-users.caddy
		}
		header Cache-Control "no-store"
		reverse_proxy eth-room-finder-api:8790
	}
	handle /api/* {
		respond 404
	}

	handle {
		root * /srv
		# everything is small: re-check on every visit so a deploy or new data shows immediately
		header Cache-Control "no-cache"
		# connect-src: the map (map.html) loads its tiles and fonts from OpenFreeMap
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' https://ethz.ch data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://tiles.openfreemap.org"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options SAMEORIGIN
			Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
			Strict-Transport-Security "max-age=31536000"
			-Server
		}
		# only the site itself: no hidden files, no temp files from a write in progress
		@hidden path */.* *.tmp
		respond @hidden 404
		file_server
	}
}
